@* Bottom action bar showing zone info, connection status with ping, degraded detection,
    and embedded ActionBar component. The reconnecting banner is shown above the footer
    when the hub connection enters the Reconnecting state. *@

<MudAppBar Bottom="true" Fixed Dense>
    <MudContainer Fixed Gutters="false">
        @* Reconnecting banner (absolute positioned above footer) *@
        @if (ShowReconnectingBanner)
        {
            <MudStack Row AlignItems="AlignItems.Center">
                <MudProgressCircular Indeterminate Size="Size.Small" />
                <MudText Typo="Typo.caption">Reconnecting to game server...</MudText>
            </MudStack>
        }

        <MudStack Row StretchItems="StretchItems.All">
            <MudStack Row>
                @if (!string.IsNullOrEmpty(GameState.CurrentZoneName))
                {
                    <span class="game-footer-zone">📍 @GameState.CurrentZoneName</span>
                }
                else
                {
                    <span class="game-footer-zone">No zone</span>
                }
                @if (PlayerCount > 0)
                {
                    <span class="game-footer-connid" title="Players online">👥 @PlayerCount</span>
                }
            </MudStack>


            <MudStack Row>
                @if (GameState.IsInCombat)
                {
                    <ActionBar ShowAttack="true" ShowDefend="true" ShowFlee="true"
                               ShowRespawn="GameState.CurrentCharacter.IsDead" />
                }
                else
                {
                    <ActionBar ShowSearch="!GameState.IsInCombat" ShowRest="GameState.CurrentZone.HasInn"
                               OnSearch="SearchAsync" OnRest="RestAsync" />
                }
            </MudStack>
        </MudStack>
    </MudContainer>
    <MudSpacer />
    <MudStack Row StretchItems="StretchItems.Middle" AlignItems="AlignItems.Center">
        <MudText Typo="Typo.caption">
            <MudStack Row AlignItems="AlignItems.Center" Spacing="1" style="@DotClass">
                <MudIcon Icon="@Icons.Material.Filled.Circle" Size="Size.Small" />
                @StatusText
            </MudStack>
        </MudText>
        @if (PingMs > 0 && Status != StatusIndicator.Reconnecting)
        {
            <MudText Typo="Typo.caption">@($"{PingMs}ms")</MudText>
        }
        @if (!string.IsNullOrEmpty(GameState.ServerConnectionId))
        {
            <MudText Typo="Typo.caption" Color="Color.Transparent" Class="hover">
                #@GameState.ServerConnectionId[..Math.Min(8, GameState.ServerConnectionId.Length)]
            </MudText>
        }
    </MudStack>


</MudAppBar>