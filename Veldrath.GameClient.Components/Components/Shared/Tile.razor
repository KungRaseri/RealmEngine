@using Veldrath.GameClient.Core.Abstractions
@* Single tile renderer for the zone tilemap viewport. Renders a <div> with the appropriate CSS class,
   entity overlays, and hover/mouseleave events for the info card. *@

<MudPaper Elevation="1" Class="d-flex align-center justify-center" Style="@GetTileStyle()"
          @onclick="() => OnClick.InvokeAsync((X, Y))"
          @onmouseenter="() => OnHover.InvokeAsync((X, Y))"
          @onmouseleave="() => OnHover.InvokeAsync((-1, -1))"
          title="@($"({X}, {Y})")">
    @if (IsPlayerHere)
    {
        <MudIcon Icon="Icons.Material.Filled.PersonPinCircle" Color="Color.Warning" Size="Size.Small" title="You are here" />
    }
    @if (Occupant is not null)
    {
        <MudIcon Icon="Icons.Material.Filled.Person" Color="Color.Info" Size="Size.Small" title="@Occupant.CharacterName" />
    }
    @if (Enemy is not null)
    {
        <MudIcon Icon="Icons.Material.Filled.Dangerous" Color="Color.Error" Size="Size.Small" title="@($"{Enemy.EnemyName} (Lv. {Enemy.Level})")" />
    }
</MudPaper>

@code {
    /// <summary>The tile data to render.</summary>
    [Parameter] public Veldrath.GameClient.Core.Abstractions.Tile TileData { get; set; } = null!;

    /// <summary>The map column position of this tile.</summary>
    [Parameter] public int X { get; set; }

    /// <summary>The map row position of this tile.</summary>
    [Parameter] public int Y { get; set; }

    /// <summary>Callback when the tile is clicked. Receives the tile's map coordinates.</summary>
    [Parameter] public EventCallback<(int X, int Y)> OnClick { get; set; }

    /// <summary>
    /// Callback when the mouse enters or leaves the tile.
    /// Receives the tile's map coordinates, or (-1, -1) on mouse leave.
    /// </summary>
    [Parameter] public EventCallback<(int X, int Y)> OnHover { get; set; }

    /// <summary>Whether the player is currently on this tile.</summary>
    [Parameter] public bool IsPlayerHere { get; set; }

    /// <summary>An occupant (other player) on this tile, if any.</summary>
    [Parameter] public OccupantInfo? Occupant { get; set; }

    /// <summary>An enemy on this tile, if any.</summary>
    [Parameter] public EnemyInfo? Enemy { get; set; }

    /// <summary>Returns an inline CSS style string for the tile based on its type, including fixed dimensions and background color.</summary>
    private string GetTileStyle() => TileData.Type switch
    {
        0 => "background-color: #3A3A5C; width: 36px; height: 36px; border-radius: 4px; cursor: pointer;",
        1 => "background-color: #2A1A1A; width: 36px; height: 36px; border-radius: 4px; cursor: pointer;",
        2 => "background-color: #1A3A5C; width: 36px; height: 36px; border-radius: 4px; cursor: pointer;",
        3 => "background-color: #5C4A1A; width: 36px; height: 36px; border-radius: 4px; cursor: pointer;",
        4 => "background-color: #4A4A3A; width: 36px; height: 36px; border-radius: 4px; cursor: pointer;",
        5 => "background-color: #3A2A1A; width: 36px; height: 36px; border-radius: 4px; cursor: pointer;",
        -1 => "background-color: #0D0D1A; width: 36px; height: 36px; border-radius: 4px; cursor: pointer;",
        _ => "background-color: #1A1A2E; width: 36px; height: 36px; border-radius: 4px; cursor: pointer;"
    };
}
